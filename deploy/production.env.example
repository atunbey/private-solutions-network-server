# Copy this file to deploy/production.env on the server and set real values.
# Use immutable tags (for example, a Git SHA or release version) instead of 'latest'.

# Active release used by admin-api, policy-api, and balena-orchestrator images.
PSN_RELEASE=2026.06.23.1

# Previous known-good release kept for rollback operations.
PSN_PREVIOUS_RELEASE=2026.06.22.3

# Optional overrides for registry/repository names.
ADMIN_API_IMAGE=ghcr.io/atunbey/private-solutions-network-server/admin-api
POLICY_API_IMAGE=ghcr.io/atunbey/private-solutions-network-server/policy-api
ORCHESTRATOR_IMAGE=ghcr.io/atunbey/private-solutions-network-server/balena-orchestrator

# Infra image pins.
POSTGRES_IMAGE=postgres:16.4
REDIS_IMAGE=redis:7.2.5-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:25.0.6
ADMIN_PORTAL_IMAGE=nginx:1.27.2-alpine
REVERSE_PROXY_IMAGE=nginx:1.27.2-alpine

# Runtime secrets and tokens (replace with production values).
BALENA_API_BASE=
BALENA_API_TOKEN=
